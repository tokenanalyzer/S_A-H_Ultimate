# ============================================================
#  S_A-H ULTIMATE — Environment Variables Template
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to git — it is gitignored.
# ============================================================

# ── AI Models (get free keys at the URLs below) ─────────────
# Groq  → https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SambaNova  → https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=your_sambanova_api_key_here

# Google Gemini  → https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── GitHub (for scanner repo cloning) ───────────────────────
# Create at: github.com → Settings → Developer settings → PAT
# Required scope: repo (read-only is enough for public repos)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Server Security ─────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace_with_64_char_random_hex_string

# ── Database ────────────────────────────────────────────────
# Replit provides this automatically when a PostgreSQL DB is attached
DATABASE_URL=postgresql://user:password@localhost:5432/sah_ultimate

# ── Optional / Auto-set ─────────────────────────────────────
# These are set automatically by the workflow runner — do not change
# PORT=8080
# BASE_PATH=/
# NODE_ENV=development
# LOG_LEVEL=info
